rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isArtist() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == '__ARTIST_EMAIL__';
    }
    match /siteContent/{id} {
      allow get: if id == 'main';
      allow list: if false;
      allow create, update: if id == 'main' && isArtist();
      allow delete: if false;
    }
    match /siteMedia/{id} {
      allow read: if true;
      allow create, update: if isArtist()
        && request.resource.data.keys().hasOnly(['kind','title','styleName','createdAt'])
        && request.resource.data.kind in ['portfolio','style','studio','award','artist','hero','logo']
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 100;
      allow delete: if isArtist();
    }
    match /siteAssets/{id} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isArtist()
        && request.resource.data.keys().hasOnly(['dataUrl'])
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() <= 900000;
      allow delete: if isArtist();
    }
    match /reviews/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name','text','rating','photo','consent','createdAt'])
        && request.resource.data.keys().hasAll(['name','text','rating','photo','consent','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 50
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 8
        && request.resource.data.text.size() <= 800
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.photo is string
        && request.resource.data.photo.size() <= 700000
        && request.resource.data.consent == true
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isArtist();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}